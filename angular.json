{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "cli": {
    "analytics": false
  },
  "projects": {
    "holorecall": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@angular/build:application",
          "options": {
            "browser": "src/main.ts",
            "tsConfig": "tsconfig.app.json",
            "index": "src/index.html",
            "allowedCommonJsDependencies": ["exceljs", "jszip", "sql.js/dist/sql-wasm-browser.js"],
            "assets": [
              {
                "glob": "**/*",
                "input": "public"
              },
              {
                "glob": "sql-wasm-browser.wasm",
                "input": "node_modules/sql.js/dist",
                "output": "runtime"
              }
            ],
            "styles": [
              "node_modules/@fontsource/roboto/latin-400.css",
              "node_modules/@fontsource/roboto/latin-500.css",
              "node_modules/@fontsource/roboto/latin-700.css",
              "src/theme.scss",
              "src/styles.css"
            ]
          },
          "configurations": {
            "production": {
              "outputHashing": "all",
              "budgets": [
                {
                  "type": "initial",
                  "maximumWarning": "850kB",
                  "maximumError": "1MB"
                }
              ]
            },
            "development": {
              "optimization": false,
              "sourceMap": true,
              "extractLicenses": false
            }
          },
          "defaultConfiguration": "production"
        },
        "serve": {
          "builder": "@angular/build:dev-server",
          "configurations": {
            "development": {
              "buildTarget": "holorecall:build:development"
            },
            "production": {
              "buildTarget": "holorecall:build:production"
            }
          },
          "defaultConfiguration": "development"
        }
      }
    }
  }
}
